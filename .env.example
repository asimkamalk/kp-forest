# Copy to .env and fill in values. Never commit real secrets.

# App (pooled Neon URL in production / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kp_forest?schema=public"

# Prisma migrate needs a direct (non-pooler) connection
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/kp_forest?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public origin — sitemap, metadata, Auth.js
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Required on Vercel / behind reverse proxies
AUTH_TRUST_HOST="true"
