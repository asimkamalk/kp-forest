# Copy to .env and fill in values. Never commit real secrets.

# App (pooled Neon URL in production / Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kp_forest?schema=public"

# Prisma migrate needs a direct (non-pooler) connection
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/kp_forest?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Public origin — sitemap, metadata, Auth.js
APP_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Required on Vercel / behind reverse proxies
AUTH_TRUST_HOST="true"

# Vercel Blob — required for dashboard image uploads on Vercel
# Create a Blob store in the Vercel dashboard (Storage), then redeploy.
# BLOB_READ_WRITE_TOKEN=""

# Optional — super admin created/updated by db:seed and db:rotate-admin
# SEED_ADMIN_EMAIL=""
# SEED_ADMIN_PASSWORD=""

# Optional legacy admin cleanup (set explicitly if you want it)
# LEGACY_ADMIN_EMAIL=""
# DELETE_LEGACY_ADMIN="false"
